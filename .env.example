# Server-side configuration only. Copy to .env.local and fill the existing trial key.
# No application/config loader exists yet; these names define the stage-0 contract.
# Never rename these variables with a NEXT_PUBLIC_ prefix.
KB_EMBEDDING_PROVIDER=moark
KB_EMBEDDING_BASE_URL=https://api.moark.com/v1
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=Qwen3-Embedding-8B
KB_EMBEDDING_DIMENSIONS=4096
KB_EMBEDDING_ENCODING_FORMAT=float
KB_EMBEDDING_FAILOVER_ENABLED=false
KB_EMBEDDING_TIMEOUT_SECONDS=60
KB_EMBEDDING_MAX_RETRIES=0
KB_EMBEDDING_MAX_CONCURRENCY=1
KB_EMBEDDING_BATCH_SIZE=1
# Provider trial allowance observed in the UI; shared account usage can reduce it.
KB_EMBEDDING_ACCESS_MODE=free_trial
KB_EMBEDDING_DAILY_REQUEST_LIMIT=100
# Local policy only: paid calls and automatic paid fallback are not authorized.
KB_EMBEDDING_PAID_CALLS_ALLOWED=false
