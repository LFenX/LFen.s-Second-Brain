# Server-side configuration contract only; no business/config loader exists yet.
# Copy to .env.local. Fill the Beijing workspace ID, native DashScope API roots,
# and credential locally. Never use NEXT_PUBLIC_ prefixes or commit real keys.
# The two Bailian API_KEY fields may share their dedicated, authorized key.
# DeepSeek requires its own credential.
KB_MODEL_REGION=cn-beijing
KB_MODEL_WORKSPACE_ID=
KB_EMBEDDING_PROVIDER=aliyun_bailian
KB_EMBEDDING_API_FORMAT=dashscope
# Native API root: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_ENDPOINT=/services/embeddings/text-embedding/text-embedding
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=qwen3.7-text-embedding
KB_EMBEDDING_DIMENSIONS=2560
KB_EMBEDDING_OUTPUT_TYPE=dense
KB_EMBEDDING_ENCODING_FORMAT=float
KB_EMBEDDING_DOCUMENT_TEXT_TYPE=document
KB_EMBEDDING_QUERY_TEXT_TYPE=query
KB_EMBEDDING_QUERY_INSTRUCT=Given a code search query, retrieve relevant code snippets that implement the requested behavior.
KB_EMBEDDING_FAILOVER_ENABLED=false
KB_EMBEDDING_TIMEOUT_SECONDS=60
KB_EMBEDDING_MAX_RETRIES=0
KB_EMBEDDING_MAX_CONCURRENCY=1
KB_EMBEDDING_BATCH_SIZE=1
KB_EMBEDDING_ACCESS_MODE=stage0_validation
# Ordinary multi-input requests are real-time; discounted Batch is asynchronous.
KB_EMBEDDING_ASYNC_BATCH_ENABLED=false
KB_EMBEDDING_PAID_CALLS_ALLOWED=false
KB_RERANK_PROVIDER=aliyun_bailian
KB_RERANK_API_FORMAT=dashscope
KB_RERANK_BASE_URL=
KB_RERANK_ENDPOINT=/services/rerank/text-rerank/text-rerank
KB_RERANK_API_KEY=
KB_RERANK_MODEL=qwen3.7-text-rerank
KB_RERANK_INSTRUCT=Given a code search query, rank candidate documents by how directly they implement the requested behavior.
KB_RERANK_TIMEOUT_SECONDS=60
KB_RERANK_MAX_RETRIES=0
KB_RERANK_MAX_CONCURRENCY=1
KB_RERANK_FAILOVER_ENABLED=false
KB_RERANK_PAID_CALLS_ALLOWED=false
# Historical stage-0 limits; do not reuse these as authorization for the POC.
KB_STAGE0_MAX_INITIAL_REQUESTS=5
KB_REAL_SOURCE_EXTERNAL_CALLS_ALLOWED=false

# Proposed POC contract only. There is no loader, runner, or budget enforcer yet.
# Keep existing .env.local values; append missing fields rather than overwriting it.
# Create a separate DeepSeek credential locally. Never put it in this template.
KB_GENERATION_ENABLED=false
KB_GENERATION_PROVIDER=deepseek
KB_GENERATION_API_FORMAT=openai_chat_completions
KB_GENERATION_BASE_URL=https://api.deepseek.com
KB_GENERATION_ENDPOINT=/chat/completions
KB_GENERATION_API_KEY=
KB_GENERATION_MODEL=deepseek-flash
KB_GENERATION_THINKING=enabled
KB_GENERATION_REASONING_EFFORT=high
KB_GENERATION_MAX_OUTPUT_TOKENS=8192
KB_GENERATION_STREAM=true
KB_GENERATION_STREAM_INCLUDE_USAGE=true
KB_GENERATION_TIMEOUT_SECONDS=120
KB_GENERATION_MAX_RETRIES=0
KB_GENERATION_MAX_CONCURRENCY=1
KB_GENERATION_FAILOVER_ENABLED=false
KB_GENERATION_PAID_CALLS_ALLOWED=false

# Recommended experiment ceilings, pending source selection and execution approval.
# These are NOT enforced by the presence of this file.
KB_POC_ENABLED=false
KB_POC_MAX_TOTAL_CHUNKS=5000
KB_POC_EMBEDDING_BATCH_SIZE=20
KB_POC_MAX_EMBEDDING_INPUT_TOKENS=32000
KB_POC_MAX_EMBEDDING_REQUESTS=400
KB_POC_MAX_RERANK_REQUESTS=200
KB_POC_MAX_GENERATION_REQUESTS=200
KB_POC_BAILIAN_BUDGET_CNY=10
KB_POC_DEEPSEEK_BUDGET_USD=5
KB_POC_MAX_RERANK_INPUT_TOKENS=32000
KB_POC_CONTEXT_TOKENS=8192
