{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lfen:knowledge-answer:0.1:candidate:01",
  "title": "KQA-20261117-02 owner web knowledge answer candidate",
  "x-status": "CandidateReadyForSpecificHumanDecision_NotImplementationContract",
  "$comment": "No implementation authority. Human decision must bind the exact subject manifest;existing C3 definitions are imported without modification.",
  "$defs": {
    "Version": {
      "const": "0.1.0-candidate"
    },
    "ID": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_ref",
        "selection"
      ],
      "properties": {
        "index_ref": {
          "$ref": "urn:lfen:knowledge-content-lexical:0.2:candidate:03#/$defs/LexicalIndexRef"
        },
        "selection": {
          "allOf": [
            {
              "$ref": "urn:lfen:knowledge-content-lexical:0.2:candidate:03#/$defs/LexicalSelection"
            },
            {
              "properties": {
                "targets": {
                  "uniqueItems": true
                }
              }
            }
          ]
        }
      }
    },
    "ModelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "configuration_sha256"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/ID"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_targets",
        "retrieval_limit",
        "max_context_utf8_bytes",
        "max_question_utf8_bytes",
        "max_output_tokens",
        "max_answer_utf8_bytes"
      ],
      "properties": {
        "max_targets": {
          "const": 32
        },
        "retrieval_limit": {
          "const": 5
        },
        "max_context_utf8_bytes": {
          "const": 32768
        },
        "max_question_utf8_bytes": {
          "const": 4096
        },
        "max_output_tokens": {
          "const": 1024
        },
        "max_answer_utf8_bytes": {
          "const": 8192
        }
      }
    },
    "InspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "model_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "model_id": {
          "$ref": "#/$defs/ID"
        }
      }
    },
    "PolicyGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "PolicySetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "expected_version",
        "enabled",
        "scope",
        "model_ref",
        "confirmed",
        "external_send_confirmed",
        "idempotency_key"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "expected_version": {
          "$ref": "#/$defs/Generation"
        },
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "const": true
        },
        "external_send_confirmed": {
          "type": "boolean"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Key"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "$ref": "#/$defs/Scope"
              },
              "model_ref": {
                "$ref": "#/$defs/ModelRef"
              },
              "external_send_confirmed": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "type": "null"
              },
              "model_ref": {
                "type": "null"
              },
              "external_send_confirmed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "AnswerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "expected_policy_version",
        "question",
        "retrieval_query",
        "idempotency_key"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "expected_policy_version": {
          "$ref": "#/$defs/Generation"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 4096
        },
        "retrieval_query": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "x-max-utf8-bytes": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "$ref": "#/$defs/Key"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "version",
        "enabled",
        "scope",
        "scope_sha256",
        "model_ref",
        "consent_actor",
        "consent_time"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/ID"
        },
        "version": {
          "$ref": "#/$defs/Generation"
        },
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "consent_actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "consent_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "$ref": "#/$defs/Scope"
              },
              "scope_sha256": {
                "$ref": "#/$defs/Hash"
              },
              "model_ref": {
                "$ref": "#/$defs/ModelRef"
              },
              "consent_actor": {
                "$ref": "#/$defs/ID"
              },
              "consent_time": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "type": "null"
              },
              "scope_sha256": {
                "type": "null"
              },
              "model_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "InspectData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "scope",
        "scope_sha256",
        "model_ref",
        "model_display_name",
        "destination_origin",
        "readiness",
        "limits",
        "model_calls"
      ],
      "properties": {
        "policy_version": {
          "$ref": "#/$defs/Generation"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "scope_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "model_ref": {
          "$ref": "#/$defs/ModelRef"
        },
        "model_display_name": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 256
        },
        "destination_origin": {
          "type": "string",
          "pattern": "^https://[^/?#@\\s]+$"
        },
        "readiness": {
          "const": "ready"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "model_calls": {
          "const": 0
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ref",
        "text",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[1-5]$"
        },
        "evidence_ref": {
          "$ref": "urn:lfen:knowledge-content-lexical:0.2:candidate:03#/$defs/LexicalEvidence"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 8192
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Running": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_id",
        "state",
        "policy_version",
        "scope_sha256",
        "model_ref",
        "provider_calls",
        "replayed"
      ],
      "properties": {
        "answer_id": {
          "$ref": "#/$defs/ID"
        },
        "state": {
          "const": "running"
        },
        "policy_version": {
          "$ref": "#/$defs/Generation"
        },
        "scope_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "model_ref": {
          "$ref": "#/$defs/ModelRef"
        },
        "provider_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "Completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_id",
        "state",
        "policy_version",
        "scope_sha256",
        "model_ref",
        "answer",
        "insufficient_evidence",
        "citations",
        "usage",
        "provider_calls",
        "replayed"
      ],
      "properties": {
        "answer_id": {
          "$ref": "#/$defs/ID"
        },
        "state": {
          "const": "completed"
        },
        "policy_version": {
          "$ref": "#/$defs/Generation"
        },
        "scope_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "model_ref": {
          "$ref": "#/$defs/ModelRef"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 8192
        },
        "insufficient_evidence": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "insufficient_evidence": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "citations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_calls": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "insufficient_evidence": {
                "const": true
              },
              "citations": {
                "maxItems": 0
              },
              "usage": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "contract_version",
        "request_id",
        "data",
        "answer_id",
        "code",
        "message",
        "outcome_known",
        "retry_same_key"
      ],
      "properties": {
        "operation": {
          "enum": [
            "inspect",
            "getPolicy",
            "setPolicy",
            "answer"
          ]
        },
        "contract_version": {
          "$ref": "#/$defs/Version"
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "type": "null"
        },
        "answer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "enum": [
            "invalid_request",
            "unauthenticated",
            "not_found",
            "model_use_denied",
            "version_conflict",
            "idempotency_conflict",
            "scope_changed",
            "index_stale",
            "unsupported_model",
            "model_output_invalid",
            "provider_unavailable",
            "provider_outcome_unknown",
            "capacity_exceeded",
            "rate_limited",
            "unavailable",
            "contract_mismatch"
          ]
        },
        "message": {
          "const": "Knowledge answer operation could not be completed"
        },
        "outcome_known": {
          "type": "boolean"
        },
        "retry_same_key": {
          "const": false
        }
      }
    },
    "InspectResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "contract_version",
            "request_id",
            "data"
          ],
          "properties": {
            "operation": {
              "const": "inspect"
            },
            "contract_version": {
              "$ref": "#/$defs/Version"
            },
            "request_id": {
              "$ref": "#/$defs/ID"
            },
            "data": {
              "$ref": "#/$defs/InspectData"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "properties": {
                "operation": {
                  "const": "inspect"
                }
              }
            }
          ]
        }
      ]
    },
    "PolicyGetResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "contract_version",
            "request_id",
            "data"
          ],
          "properties": {
            "operation": {
              "const": "getPolicy"
            },
            "contract_version": {
              "$ref": "#/$defs/Version"
            },
            "request_id": {
              "$ref": "#/$defs/ID"
            },
            "data": {
              "$ref": "#/$defs/Policy"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "properties": {
                "operation": {
                  "const": "getPolicy"
                }
              }
            }
          ]
        }
      ]
    },
    "PolicySetResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "contract_version",
            "request_id",
            "data"
          ],
          "properties": {
            "operation": {
              "const": "setPolicy"
            },
            "contract_version": {
              "$ref": "#/$defs/Version"
            },
            "request_id": {
              "$ref": "#/$defs/ID"
            },
            "data": {
              "$ref": "#/$defs/Policy"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "properties": {
                "operation": {
                  "const": "setPolicy"
                }
              }
            }
          ]
        }
      ]
    },
    "AnswerResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "contract_version",
            "request_id",
            "data"
          ],
          "properties": {
            "operation": {
              "const": "answer"
            },
            "contract_version": {
              "$ref": "#/$defs/Version"
            },
            "request_id": {
              "$ref": "#/$defs/ID"
            },
            "data": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Running"
                },
                {
                  "$ref": "#/$defs/Completed"
                }
              ]
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "properties": {
                "operation": {
                  "const": "answer"
                }
              }
            }
          ]
        }
      ]
    },
    "ModelOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "insufficient_evidence",
        "evidence_ids"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 8192
        },
        "insufficient_evidence": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[1-5]$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "insufficient_evidence": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/InspectRequest"
    },
    {
      "$ref": "#/$defs/PolicyGetRequest"
    },
    {
      "$ref": "#/$defs/PolicySetRequest"
    },
    {
      "$ref": "#/$defs/AnswerRequest"
    },
    {
      "$ref": "#/$defs/InspectResponse"
    },
    {
      "$ref": "#/$defs/PolicyGetResponse"
    },
    {
      "$ref": "#/$defs/PolicySetResponse"
    },
    {
      "$ref": "#/$defs/AnswerResponse"
    }
  ]
}
